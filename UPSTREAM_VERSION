# The upstream rustdesk/rustdesk-server commit this fork's patch series sits on.
# .github/workflows/upstream-watch.yaml reads this file, compares
# UPSTREAM_RELEASE with upstream's latest GitHub release, and opens a PR when
# they differ. UPSTREAM_COMMIT is the upstream commit most recently merged; the
# sync merges the new release into main, so nothing is rebased and it is for the
# record only.
#
# UPSTREAM_COMMIT is deliberately *ahead* of the UPSTREAM_RELEASE tag: it is the
# head of upstream master when it was last merged (2026-10-29: 873230e, the
# punch-request bound #713 and key file permissions #705), which also carries the
# UDP reflection/amplification fix (109d9a2) and hbb_common 69cea8d. See NOTES.md,
# "Base selection" and "Upstream merge 2026-10-29".
UPSTREAM_RELEASE=1.1.16
UPSTREAM_COMMIT=873230e35a8805de7fd057e7eb763c46f7a174ef
UPSTREAM_HBB_COMMON=69cea8dafee147848ae88702029f4bf7df7224c3
