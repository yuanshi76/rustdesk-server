# s6 + API image: the same s6 supervision tree as docker/Dockerfile, layered on
# top of lejianwen/rustdesk-api so that hbbs, hbbr and the API server run in one
# container. This is the fork's variant (patch 0003); it pulls a third-party
# base image, which is why it is not the default image.
#
# Build context is ./docker, same as the default image.

# Declared before the first FROM so it can be used in one. Override with
# --build-arg API_IMAGE=... to pin a digest.
ARG API_IMAGE=lejianwen/rustdesk-api:latest

FROM --platform=$BUILDPLATFORM alpine:3.20 AS s6
ARG TARGETARCH
ARG S6_OVERLAY_VERSION=3.2.0.0
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) s6_arch=x86_64 ;; \
      arm64) s6_arch=aarch64 ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}"; \
    wget -qO /tmp/noarch.tar.xz "${base}/s6-overlay-noarch.tar.xz"; \
    wget -qO /tmp/arch.tar.xz   "${base}/s6-overlay-${s6_arch}.tar.xz"; \
    mkdir -p /s6root; \
    tar -C /s6root -Jxpf /tmp/noarch.tar.xz; \
    tar -C /s6root -Jxpf /tmp/arch.tar.xz; \
    rm -f /tmp/*.tar.xz

FROM ${API_IMAGE}
ARG TARGETARCH

COPY --from=s6 /s6root /
RUN ln -s /run /var/run || true

COPY rootfs /
COPY rootfs-api /
COPY bin/${TARGETARCH}/hbbs /usr/bin/hbbs
COPY bin/${TARGETARCH}/hbbr /usr/bin/hbbr
COPY bin/${TARGETARCH}/rustdesk-utils /usr/bin/rustdesk-utils
RUN chmod -v a+x /usr/bin/hbbs /usr/bin/hbbr /usr/bin/rustdesk-utils /usr/bin/healthcheck.sh

ENV RELAY=relay.example.com
ENV ENCRYPTED_ONLY=0
ENV MUST_LOGIN=N
ENV WS_IDLE_TIMEOUT=90

# 21114 is the API server.
EXPOSE 21114 21115 21116 21116/udp 21117 21118 21119

HEALTHCHECK --interval=10s --timeout=5s CMD /usr/bin/healthcheck.sh

# apimain expects to run from /app and keeps its state in /app/data.
WORKDIR /app

VOLUME /data
VOLUME /app/data

ENTRYPOINT ["/init"]
